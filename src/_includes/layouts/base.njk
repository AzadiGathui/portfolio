<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="icon" href="/assets/images/branding/AG Favicon Light on Dark.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/images/branding/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/images/branding/apple-touch-icon.png">
  <!-- Self-hosted fonts: preload the two faces every page renders first -->
  <link rel="preload" href="/assets/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">

  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:image" content="{{ ogImage | default('/assets/images/branding/AG Favicon Light on Dark.svg') }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>
  {% include "partials/nav.njk" %}
  <div id="main">
  {{ content | safe }}
  </div>
  {% include "partials/footer.njk" %}

  {#- Speculation Rules: when a visitor hovers over (or starts tapping) a link to
      another page on this site, the browser fetches that page's HTML in advance,
      so the click feels instant. Chrome and Edge only; other browsers ignore it.
      "prefetch" downloads just the HTML, not its images, so hovering costs little.
      /admin/ is excluded (the CMS shouldn't be fetched speculatively). -#}
  <script type="speculationrules">
  {
    "prefetch": [{
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/admin/*" } }
        ]
      },
      "eagerness": "moderate"
    }]
  }
  </script>
</body>
</html>
