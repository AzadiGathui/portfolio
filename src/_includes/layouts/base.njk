<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#262626">

  <link rel="icon" href="/assets/images/branding/ag-tile-dark.svg" type="image/svg+xml">
  <link rel="icon" href="/assets/images/branding/favicon.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/assets/images/branding/apple-touch-icon.png">
  <!-- Self-hosted fonts: preload the face every page renders first -->
  <link rel="preload" href="/assets/fonts/barlow-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/style.css">

  <title>{% if title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description | default(site.description) }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{% if title %}{{ title }} | {% endif %}{{ site.title }}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  {#- Share images: a 1200 x 630 PNG by default (the monogram on the mat), or the
      page's own ogImage as a 1200px JPEG. Always an absolute address: the sites
      that read these don't resolve relative ones, and none render SVG. -#}
  {%- set shareImage = (ogImage | ogImage) if ogImage else "/assets/images/branding/og-default.png" %}
  <meta property="og:image" content="{{ site.url }}{{ shareImage }}">
  <meta property="og:image:alt" content="{% if title %}{{ title }}, by {% endif %}{{ site.title }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta name="twitter:card" content="summary_large_image">

  {#- Every page: snap.js fits blocks to the mat's squares, tools.js lets the
      tools be moved. A page or layout lists any others in `scripts`. #}
  <script src="/assets/js/snap.js" defer></script>
  <script src="/assets/js/tools.js" defer></script>
  {%- for script in scripts %}
  <script src="/assets/js/{{ script }}.js" defer></script>
  {%- endfor %}
  {#- Set before first paint, so anything JS changes (the CV's timeline) starts as it will be #}
  <script>document.documentElement.classList.add("js")</script>
  {#- ?grid on any address: draw the baseline grid and outline anything off it (grid.js) #}
  <script>if (/[?&]grid\b/.test(location.search)) document.head.append(Object.assign(document.createElement("script"), { src: "/assets/js/grid.js" }))</script>
  {#- Changing page (style.css, "Motion between and within pages"): which
      way the sheet slides, by the keys' order (Home and its projects, CV,
      Lab), and how far the old page was scrolled, so its sheet leaves from
      where it was being read. Inline, so it's ready before the first paint. #}
  <script>
    (() => {
      const rank = (url) => {
        const path = new URL(url).pathname;
        return path === "/" ? 0 : path.startsWith("/projects/") ? 1 : path.startsWith("/resume") ? 2 : 3;
      };
      addEventListener("pageswap", (e) => {
        if (e.viewTransition) sessionStorage.setItem("sheet-scroll", String(scrollY));
      });
      addEventListener("pagereveal", (e) => {
        if (!e.viewTransition) return;
        const from = window.navigation?.activation?.from?.url;
        if (from) e.viewTransition.types.add(rank(location.href) < rank(from) ? "back" : "forward");
        document.documentElement.style.setProperty("--vt-from", `-${sessionStorage.getItem("sheet-scroll") || 0}px`);
      });
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  {#- The page: a cutting mat on a desk. Blocks are placed in mat cells
      (--w / --h, see "Blocks" in style.css); .gap blocks are empty rows. #}
  <div class="desk">
    <div class="mat">
      {% include "partials/nav.njk" %}

      <main class="mat__content" id="main">
        {{ content | safe }}

        <div class="gap" aria-hidden="true"></div>
        {% include "partials/footer.njk" %}
      </main>

      {#- Tools lying on the mat, from the page's or layout's `tools` list.
          Each is placed by cell: --c column, --r row, --w / --h size,
          --cs / --rs / --ws / --hs the same on a phone, --rot a tilt.
          `edge` is the side it hangs over (l, r or t). #}
      {%- if tools %}
      <div class="mat__tools" aria-hidden="true">
        {%- for tool in tools %}
        <div class="tool tool--{{ tool.edge }}" style="{{ tool.at }}">{{ tool.name }}</div>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>
  </div>

  {#- Outside the desk: the desk is a size container, which would hold the
      bar's position: fixed to the desk instead of the screen -#}
  {%- if readingBar %}{% include "partials/reading-bar.njk" %}{% endif %}

  {#- Speculation Rules: when a visitor hovers over (or starts tapping) a link to
      another page on this site, the browser fetches that page's HTML in advance,
      so the click feels instant. Chrome and Edge only; other browsers ignore it.
      "prefetch" downloads just the HTML, not its images, so hovering costs little.
      /admin/ is excluded (the CMS shouldn't be fetched speculatively). -#}
  <script type="speculationrules">
  {
    "prefetch": [{
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": { "href_matches": "/admin/*" } }
        ]
      },
      "eagerness": "moderate"
    }]
  }
  </script>
</body>
</html>
