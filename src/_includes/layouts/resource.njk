---
layout: layouts/base.njk
---
<header>
  {% if coverImage %}
  <div class="cover" style="background: url('{{ coverImage }}') #1a1a1a 50% / cover no-repeat;"></div>
  {% endif %}

  <div class="pj-deets">
    <div class="pj-title">
      {% if type %}<span class="label">{{ type }}</span>{% endif %}
      <h1>{{ title }}</h1>
      {% if tagline %}<p>{{ tagline }}</p>{% endif %}
    </div>
  </div>
</header>

{% set tocItems = content | tocEntries %}

<main>
  {% if tocItems.length %}
  <div class="pj-layout">
    <aside class="pj-toc-sidebar" aria-label="Table of contents">
      <nav class="toc">
        <span class="label label--muted">Contents</span>
        <ul class="toc__list">
          {% for item in tocItems %}
          <li><a href="#{{ item.id }}" class="toc__link">{{ item.text }}</a></li>
          {% endfor %}
          <li><a href="#" class="toc__link toc__link--top">↑ Back to top</a></li>
          <li><a href="#" class="toc__link toc__link--bottom" id="toc-bottom-link">↓ Scroll to bottom</a></li>
        </ul>
      </nav>
    </aside>
    <div class="pj-content">
      {{ content | safe }}
    </div>
  </div>
  {% else %}
  {{ content | safe }}
  {% endif %}
</main>

{% set currentIndex = collections.resources | getCollectionIndex(page.url) %}
{% set prevResource = collections.resources[currentIndex - 1] if currentIndex > 0 else null %}
{% set nextResource = collections.resources[currentIndex + 1] if currentIndex < collections.resources.length - 1 else null %}

<script>
(function () {
  var bottomLink = document.getElementById('toc-bottom-link');
  if (bottomLink) {
    bottomLink.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    });
  }

  var links = [...document.querySelectorAll('.toc__link[href^="#"]:not([href="#"])')];
  if (!links.length) return;

  var headings = links.map(function (l) {
    return document.querySelector(l.getAttribute('href'));
  }).filter(Boolean);

  function setActive() {
    var threshold = window.innerHeight * 0.25;
    var active = null;
    for (var i = 0; i < headings.length; i++) {
      if (headings[i].getBoundingClientRect().top <= threshold) {
        active = links[i];
      }
    }
    links.forEach(function (l) { l.classList.remove('toc__link--active'); });
    if (active) active.classList.add('toc__link--active');
  }

  window.addEventListener('scroll', setActive, { passive: true });
  setActive();
})();
</script>

{% if prevResource or nextResource %}
<nav class="pj-nav" aria-label="Resource navigation">
  <div class="pj-nav__item pj-nav__item--prev">
    {% if prevResource %}
      <a href="{{ prevResource.url }}" class="pj-nav__link">
        <span class="label label--muted">← Previous</span>
        <span class="pj-nav__title">{{ prevResource.data.title }}</span>
        {% if prevResource.data.tagline %}
          <span class="pj-nav__tagline">{{ prevResource.data.tagline }}</span>
        {% endif %}
      </a>
    {% endif %}
  </div>
  <div class="pj-nav__item pj-nav__item--next">
    {% if nextResource %}
      <a href="{{ nextResource.url }}" class="pj-nav__link">
        <span class="label label--muted">Next →</span>
        <span class="pj-nav__title">{{ nextResource.data.title }}</span>
        {% if nextResource.data.tagline %}
          <span class="pj-nav__tagline">{{ nextResource.data.tagline }}</span>
        {% endif %}
      </a>
    {% endif %}
  </div>
</nav>
{% endif %}
