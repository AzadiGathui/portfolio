---
layout: layouts/base.njk
readingBar: true
scripts: [reels, reading-bar, spread-zoom]
tools:
  - { img: kneadable-eraser, edge: r, at: "--c: 14; --r: 4; --rot: 4deg" }
  - { img: mechanical-pencil, edge: l, at: "--c: 1; --r: 9; --rot: -1deg" }
  - { img: icebear-cutter, edge: r, at: "--c: 14; --r: 22; --rot: 2deg" }
  - { img: sharpener, edge: l, at: "--c: 1; --r: 34; --rot: -6deg" }
---
{#- A case study: every project in src/projects/ (projects.json sets this
    layout). Header, the cover with the artefact laid on it (as on its
    homepage card), the facts, then the markdown with its contents beside
    it, then previous / next. -#}
{%- set toc = content | tocEntries %}
{%- set at = collections.projects | getProjectIndex(page.url) %}
{#- Previous and next wrap round the list, so the pager always has both -#}
{%- set next = collections.projects[at + 1] or collections.projects[0] %}
{%- set prev = collections.projects[at - 1] if at > 0 else collections.projects[collections.projects.length - 1] %}

<header class="sheet" style="--w: 10; --h: 4" data-snap>
  <span class="label">{{ industry }}</span>
  <h1>{{ title }}{% if titleSup %}<sup class="title-sup">{{ titleSup }}</sup>{% endif %}</h1>
  <p>{{ description }}</p>
</header>

<figure class="sheet cover" style="--h: 6">
  <div class="frame frame--plain"><img src="{{ coverImage }}" alt="" sizes="(max-width: 720px) 90vw, 880px" loading="eager"{% if coverPosition %} style="object-position: {{ coverPosition }}"{% endif %}></div>
  {%- if thumbnail %}
  {%- if thumbnailKind == 'phone' and mockupImage %}
  <span class="card__art card__art--phone"><span class="phone-frame"><img src="{{ mockupImage }}" alt="" sizes="(max-width: 720px) 30vw, 160px" loading="eager"></span></span>
  {%- else %}
  <span class="card__art card__art--{{ thumbnailKind or 'print' }}"><img src="{{ thumbnail }}" alt="" sizes="220px" loading="eager"></span>
  {%- endif %}
  {%- endif %}
</figure>

<dl class="sheet facts" style="--x: 6; --w: 7; --h: 3" data-snap>
  <div><dt class="label">Client</dt><dd>{{ client }}</dd></div>
  {%- if role %}<div><dt class="label">Role</dt><dd>{{ role }}</dd></div>{% endif %}
  {%- if timeline %}<div><dt class="label">Timeline</dt><dd>{{ timeline }}</dd></div>{% endif %}
  {%- if platform %}<div><dt class="label">Platform</dt><dd>{{ platform }}</dd></div>{% endif %}
  {%- if deliverables %}<div><dt class="label">Deliverables</dt><dd>{{ deliverables }}</dd></div>{% endif %}
  {%- if team %}
  {#- team (optional): the people who did the work with me: [{ name, role, url? }] #}
  <div><dt class="label">Team</dt><dd><ul class="team">
    {%- for member in team %}
    <li>{% if member.url %}<a href="{{ member.url }}" rel="noopener">{{ member.name }}</a>{% else %}{{ member.name }}{% endif %} <span class="team__role">{{ member.role }}</span></li>
    {%- endfor %}
  </ul></dd></div>
  {%- endif %}
</dl>

<div class="gap" aria-hidden="true"></div>

<!-- The story: contents on the left stick while the body scrolls -->
<div class="sheet area study" data-snap>
  {%- if toc.length %}
  <nav class="toc" aria-label="On this page">
    <ol>
      {%- for item in toc %}
      <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
      {%- endfor %}
    </ol>
  </nav>
  {%- endif %}
  <div class="area study__body">
    <div class="sheet prose" data-snap>{{ content | safe }}</div>
  </div>
</div>

<div class="gap" aria-hidden="true"></div>

<nav class="sheet area pager" aria-label="Project navigation">
  {%- for dir, p in [["prev", prev], ["next", next]] %}
  <a class="frame pager__item pager__item--{{ dir }}" href="{{ p.url }}">
    <span class="pager__thumb"><img src="{{ p.data.thumbnail or p.data.coverImage }}" alt="" sizes="(max-width: 720px) 30vw, 280px" loading="lazy"></span>
    <span class="label pager__label">{% if dir == "prev" %}&larr; Previous{% else %}Next &rarr;{% endif %}</span>
    <h3 class="pager__title">{{ p.data.title }}</h3>
  </a>
  {%- endfor %}
</nav>
