---
layout: layouts/base.njk
---
<header>
  <div class="cover" style="background: url('{{ coverImage }}') lightgray 50% / cover no-repeat;">
    {% if mockupImage %}
      <img src="{{ mockupImage }}" alt="{{ title }} project mockup" class="pj-mockup">
    {% endif %}
  </div>

  <div class="pj-deets">
      {% if clientLogo %}
        <img src="{{ clientLogo }}" alt="{{ client }} logo" style="width: 6rem;">
      {% endif %}
      <div class="pj-title">
        <h1>{{ title }}</h1>
        {% if tagline %}<p>{{ tagline }}</p>{% endif %}
      </div>

    <table style="align-self: stretch;">
      <tr><th>Client</th><td>{{ client }}</td></tr>
      {% if industry %}<tr><th>Industry</th><td>{{ industry }}</td></tr>{% endif %}
      <tr><th>Role</th><td>{{ role }}</td></tr>
      <tr><th>Deliverables</th><td>{{ deliverables }}</td></tr>
    </table>
  </div>
</header>

{% set tocItems = content | tocEntries %}

<main>
  {% if tocItems.length %}
  <div class="pj-layout">
    <aside class="pj-toc-sidebar" aria-label="Table of contents">
      <nav class="toc">
        <span class="label label--muted">Contents</span>
        <ul class="toc__list">
          {% for item in tocItems %}
          <li><a href="#{{ item.id }}" class="toc__link">{{ item.text }}</a></li>
          {% endfor %}
          <li><a href="#" class="toc__link toc__link--top">↑ Back to top</a></li>
          <li><a href="#" class="toc__link toc__link--bottom" id="toc-bottom-link">↓ Scroll to bottom</a></li>
        </ul>
      </nav>
    </aside>
    <div class="pj-content">
      {{ content | safe }}
    </div>
  </div>
  {% else %}
  {{ content | safe }}
  {% endif %}
</main>

{% set currentIndex = collections.projects | getProjectIndex(page.url) %}
{% set prevProject = collections.projects[currentIndex - 1] if currentIndex > 0 else null %}
{% set nextProject = collections.projects[currentIndex + 1] if currentIndex < collections.projects.length - 1 else null %}

<script>
(function () {
  // Scroll to bottom
  var bottomLink = document.getElementById('toc-bottom-link');
  if (bottomLink) {
    bottomLink.addEventListener('click', function (e) {
      e.preventDefault();
      window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    });
  }

  // Active section highlight
  var links = [...document.querySelectorAll('.toc__link[href^="#"]:not([href="#"])')];
  if (!links.length) return;

  var headings = links.map(function (l) {
    return document.querySelector(l.getAttribute('href'));
  }).filter(Boolean);

  function setActive() {
    var threshold = window.innerHeight * 0.25;
    var active = null;
    for (var i = 0; i < headings.length; i++) {
      if (headings[i].getBoundingClientRect().top <= threshold) {
        active = links[i];
      }
    }
    links.forEach(function (l) { l.classList.remove('toc__link--active'); });
    if (active) active.classList.add('toc__link--active');
  }

  window.addEventListener('scroll', setActive, { passive: true });
  setActive();
})();
</script>

{% if prevProject or nextProject %}
<nav class="pj-nav" aria-label="Project navigation">
  <div class="pj-nav__item pj-nav__item--prev">
    {% if prevProject %}
      <a href="{{ prevProject.url }}" class="pj-nav__link">
        <span class="label label--muted">← Previous</span>
        <span class="pj-nav__title">{{ prevProject.data.title }}</span>
        {% if prevProject.data.tagline %}
          <span class="pj-nav__tagline">{{ prevProject.data.tagline }}</span>
        {% endif %}
      </a>
    {% endif %}
  </div>
  <div class="pj-nav__item pj-nav__item--next">
    {% if nextProject %}
      <a href="{{ nextProject.url }}" class="pj-nav__link">
        <span class="label label--muted">Next →</span>
        <span class="pj-nav__title">{{ nextProject.data.title }}</span>
        {% if nextProject.data.tagline %}
          <span class="pj-nav__tagline">{{ nextProject.data.tagline }}</span>
        {% endif %}
      </a>
    {% endif %}
  </div>
</nav>
{% endif %}
