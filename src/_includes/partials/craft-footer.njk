{#- The closing contact block on every craft page, after the live site's
    footer: the ask, the email large, then links and the CV (styles: "Footer"
    in craft.css). The Contact key jumps here (#contact). -#}
<footer class="sheet foot" id="contact" data-snap>
  <p class="foot__ask">Let’s create meaningful, systemic impact together.</p>
  <a class="foot__mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
  <div class="foot__base">
    <ul class="foot__links">
      <li><a href="{{ site.social.linkedin }}">LinkedIn</a></li>
      <li><a href="{{ site.social.github }}">GitHub</a></li>
      <li><a class="btn" href="{{ site.cvPdf }}" download>Download CV</a></li>
    </ul>
    <span class="foot__copy">© {{ "" | currentYear }} {{ site.author }}</span>
  </div>
</footer>
