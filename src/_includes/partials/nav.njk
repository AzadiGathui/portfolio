{#- Main navigation as keyboard keys (styles: "Keys" in style.css). It sits
    on the desk, above the mat (layouts/base.njk includes it before .mat), and
    is pinned while the page scrolls, so after a scroll it lies over the mat's
    top edge. Its columns are the mat's: .keys has the mat's sizing, so a key
    lands on the same squares either way.
    There is no Work key: Home is the work, so a project page lights Home too
    (aria-current="true": part of it, not the page itself). .key--icon
    shows an icon on a phone. --k column, --ks column on a phone, --kw
    width. Contact jumps to the footer (partials/footer.njk), on every page. -#}
{%- set isHome = page.url == "/" or "/projects/" in page.url %}
{%- macro current(here, exact) %}{% if here %} aria-current="{{ 'page' if exact else 'true' }}"{% endif %}{% endmacro %}
<nav class="keys" aria-label="Main">
  <a class="key" href="/" style="--k: 1; --kw: 2; --ks: 1"{{ current(isHome, page.url == "/") }}><span>Azadi<br>Gathui</span></a>
  <a class="key key--icon" href="#contact" style="--k: 12; --ks: 4"><span>Contact</span><svg class="key__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg></a>
  <a class="key key--icon" href="/resume/" style="--k: 13; --ks: 5"{{ current(page.url == "/resume/", true) }}><span>CV</span><svg class="key__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3h8L19 7.5V21H6.5z"/><path d="M14.5 3v4.5H19M9.5 12h6M9.5 15.5h6M9.5 8.5h2"/></svg></a>
  <a class="key key--icon" href="/lab/" style="--k: 14; --ks: 6"{{ current(page.url == "/lab/", true) }}><span>Lab</span><svg class="key__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 3h5M10.5 3v6.2L5 18.4A1.7 1.7 0 0 0 6.5 21h11a1.7 1.7 0 0 0 1.5-2.6L13.5 9.2V3"/><path d="M7.4 15h9.2"/></svg></a>
</nav>
<script>
  // Once the mat's top edge has scrolled up under the keys, a soft mat-coloured
  // fade sits behind them so text no longer shows between them (styles:
  // .is-scrolled in style.css). Before that the keys are on the desk and need none.
  (() => {
    const root = document.documentElement;
    // the mat comes after this script in the page, so it is looked up each time
    const update = () => {
      const mat = document.querySelector(".mat");
      if (mat) root.classList.toggle("is-scrolled", mat.getBoundingClientRect().top <= 0);
    };
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update, { passive: true });
    addEventListener("DOMContentLoaded", update);
  })();
</script>
