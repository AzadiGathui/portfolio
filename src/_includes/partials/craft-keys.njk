{#- Main navigation as keyboard keys (styles: "Keys" in craft.css).
    Set `keysActive` before including: "home", "cv" or "lab" (no Work key
    for now: Home is the work). .key--icon shows an icon on a phone.
    --k column, --ks column on a phone, --kw / --kws width (phone).
    Contact jumps to the footer (partials/craft-footer.njk), on every page. -#}
<div class="mat__keys">
  <nav class="keys" aria-label="Main">
    <a class="key" href="/craft/" style="--k: 1; --kw: 2; --ks: 1"{% if keysActive == "home" %} aria-current="page"{% endif %}><span>Azadi<br>Gathui</span></a>
    <a class="key key--icon" href="#contact" style="--k: 12; --ks: 4"><span>Contact</span><svg class="key__icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg></a>
    <a class="key" href="/craft/cv/" style="--k: 13; --ks: 5"{% if keysActive == "cv" %} aria-current="page"{% endif %}><span>CV</span></a>
    <a class="key key--icon" href="/craft/lab/" style="--k: 14; --ks: 6"{% if keysActive == "lab" %} aria-current="page"{% endif %}><span>Lab</span><svg class="key__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 3h5M10.5 3v6.2L5 18.4A1.7 1.7 0 0 0 6.5 21h11a1.7 1.7 0 0 0 1.5-2.6L13.5 9.2V3"/><path d="M7.4 15h9.2"/></svg></a>
  </nav>
</div>
<script>
  // Once the page has scrolled, a soft mat-coloured fade sits behind the keys
  // so text no longer shows between them (styles: .is-scrolled in craft.css)
  (() => {
    const root = document.documentElement;
    const update = () => root.classList.toggle("is-scrolled", scrollY > 8);
    addEventListener("scroll", update, { passive: true });
    update();
  })();
</script>
