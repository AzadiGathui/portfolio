{#- The closing contact block on every page: the ask, the email large, then
    links and the CV (styles: "Footer" in style.css). The Contact key jumps
    here (#contact). -#}
<footer class="sheet foot" id="contact" data-snap>
  <p class="foot__ask">Let’s create meaningful, systemic impact together.</p>
  <a class="foot__mail" href="mailto:{{ site.email }}">{{ site.email }}</a>
  <div class="foot__base">
    <ul class="foot__links">
      {%- if site.social.linkedin %}<li><a href="{{ site.social.linkedin }}">LinkedIn</a></li>{% endif %}
      {%- if site.social.behance %}<li><a href="{{ site.social.behance }}">Behance</a></li>{% endif %}
      {%- if site.social.github %}<li><a href="{{ site.social.github }}">GitHub</a></li>{% endif %}
      <li><a class="btn" href="{{ site.cvPdf }}" download>Download CV</a></li>
    </ul>
    <span class="foot__copy">© {{ "" | currentYear }} {{ site.author }}</span>
  </div>
</footer>
