---
layout: layouts/page.njk
title: Resume
description: UI/UX Resume of Azadi Gathui — Product Designer & Analyst with 6+ years of human-centered design experience.
permalink: /resume/
---
<header>
  <div style="padding: 2rem; margin-top: 10rem; max-width: 25rem;">
    <h1>Resumé</h1>
  </div>
</header>

<main>
  {% for job in resume %}
  <section>
    <header>
      <div class="pj-title">
        {% if job.logo %}
          <img src="{{ job.logo.src }}" style="width: {{ job.logo.width }};" alt="{{ job.logo.alt }}">
        {% endif %}
        <h2>{{ job.heading }}</h2>
      </div>
      <table style="align-self: stretch;">
        <tr><th>Role</th><td>{{ job.role }}</td></tr>
        <tr><th>Deliverables</th><td>{{ job.deliverables }}</td></tr>
      </table>
    </header>
    {% if job.images %}
    <div class="pj-reel">
      {% for img in job.images %}
      <img src="/assets/images/resume/{{ job.slug }}/{{ img }}" alt="{{ job.client }} screen {{ loop.index }}">
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endfor %}
</main>
