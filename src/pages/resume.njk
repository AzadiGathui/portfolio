---
layout: layouts/page.njk
title: Resume
description: UI/UX Resume of Azadi Gathui — Product Designer & Analyst with 6+ years of human-centered design experience.
permalink: /resume/
---
<header>
  <div style="padding: 2rem; margin-top: 10rem; max-width: 25rem;">
    <h1>UI/UX Resume</h1>
    <p>
      I am Azadi, a UI/UX Designer &amp; Researcher with 6+ years experience in human-centered design.
      <br>I specialize in creating intuitive and visually appealing digital products, with a deep passion for
      sustainable and ethical design practices.
    </p>
  </div>
</header>

<main>
  {% for job in resume %}
  <section>
    <header>
      <div class="pj-title">
        {% if job.logo %}
          <img src="{{ job.logo.src }}" style="width: {{ job.logo.width }};" alt="{{ job.logo.alt }}">
        {% endif %}
        <h2 style="font-size: 2.5rem; line-height: 90%; max-width: 20ch;">{{ job.heading }}</h2>
      </div>
      <table style="align-self: stretch;">
        <tr><th>Client</th><td>{{ job.client }}</td></tr>
        <tr><th>Role</th><td>{{ job.role }}</td></tr>
        <tr><th>Deliverables</th><td>{{ job.deliverables }}</td></tr>
      </table>
    </header>
    {% if job.images %}
    <div class="pj-reel">
      {% for img in job.images %}
      <img src="/assets/images/resume/{{ job.slug }}/{{ img }}" alt="{{ job.client }} screen {{ loop.index }}">
      {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endfor %}
</main>
