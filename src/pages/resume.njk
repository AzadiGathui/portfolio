---
layout: layouts/base.njk
title: Resume
# The role comes from site.json, so it reads the same everywhere
eleventyComputed:
  description: "Resume of Azadi Gathui, {{ site.role | lower | safe }}, with experience across fintech, healthcare, climate, and conservation."
permalink: /resume/
scripts: [reels, cv]
# The timeline's lanes, top to bottom. An entry joins one with
# `timeline: { lane: … }` in its file in src/cv/.
timelineFrom: 2020
lanes:
  - { key: data, name: "Data & ML" }
  - { key: product, name: Product }
  - { key: editorial, name: "Brand & editorial" }
---
{#- Everything below the intro is built from the files in src/cv/ (one per
    entry; see src/cv/README.md). Edit those, not this page. -#}
{%- import "partials/cv-entry.njk" as cv -%}
{%- set tl = collections.cv | cvTimeline(lanes, timelineFrom) -%}
{#- On paper ("Save as PDF"): a plain, light CV. Only applies when printing -#}
<link rel="stylesheet" href="/assets/css/cv-print.css" media="print">

{#- The intro: its text rounded up to whole squares, then the contact row
    on the squares below it (each button one or more squares) -#}
<section class="sheet area cv-intro" data-snap>
  <div class="cv-intro__text" data-cells>
    <span class="label">{{ site.role }}</span>
    <h1>Azadi Gathui</h1>
    <p class="cv__tagline">If it challenges assumptions, connects disciplines, or helps real humans live better, I'm probably already thinking about it.</p>
    <p class="cv__ask">Let’s create meaningful impact together.</p>
  </div>
  <ul class="icon-links contact" aria-label="Contact">
    <li><a class="icon-link" href="mailto:{{ site.email }}"><span class="visually-hidden">Email </span><span class="contact__address visually-hidden">{{ site.email }}</span><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/></svg></a></li>
    {%- include "partials/social-links.njk" %}
    <li data-print><button class="btn" type="button">Save as PDF</button></li>
  </ul>
</section>

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

{#- What the panel under the chart shows for one entry (cv.js copies it in
    when a bar is pointed at or chosen): the card's facts, short, and the
    way to the full card. Hidden here, so the build still resizes its images. -#}
{%- macro pv(item) -%}
<div class="tl-pv" id="pv-{{ item.id }}" hidden data-open="{{ item.open or item.id }}"{% if item.back %} data-back="{{ item.back }}"{% endif %}>
  {%- if item.thumbs.length %}
  <div class="tl-pv__thumbs" aria-hidden="true">{% for src in item.thumbs %}<img src="{{ src }}" alt="" sizes="160px">{% endfor %}</div>
  {%- endif %}
  <div class="tl-pv__text">
    <span class="label">{{ item.kind }}</span>
    <h3>{{ item.title }}</h3>
    <p class="tl-pv__meta">{{ [item.org, item.dates, item.duration] | cvJoin }}</p>
    {%- if item.group %}
    <ul class="tl-pv__list" aria-label="Projects">
      {%- for m in item.members %}
      <li><button type="button" data-pick="{{ m.id }}">{{ m.label }}<span class="visually-hidden">,</span> <span class="tl-pv__year">{{ m.years }}</span></button></li>
      {%- endfor %}
    </ul>
    {%- else %}
    {%- if item.about %}<p class="tl-pv__about">{{ item.about }}</p>{% endif %}
    {#- the first three; the card has them all -#}
    {%- if item.tags.length %}<p class="tl-pv__tags">{% for t in item.tags %}{% if loop.index <= 3 %}{{ t }}{% if loop.index < 3 and not loop.last %}, {% endif %}{% endif %}{% endfor %}{% if item.tags.length > 3 %} <span class="tl-pv__more">+{{ item.tags.length - 3 }} more</span>{% endif %}</p>{% endif %}
    {%- endif %}
  </div>
  <div class="tl-pv__actions">
    {%- if item.back %}<button class="btn" type="button" data-pick="{{ item.back }}">&larr; All projects</button>{% endif %}
    <a class="btn" href="#{{ item.open or item.id }}" data-open>Full entry <span aria-hidden="true">&darr;</span></a>
    {%- if item.caseStudy %}<a class="btn" href="{{ item.caseStudy }}">Case study <span aria-hidden="true">&rarr;</span></a>{% endif %}
  </div>
</div>
{%- endmacro -%}

<!-- The one figure: the timeline. A title and key above it, so it reads
     at once; lane chips; the chart in a frame of whole squares; a panel
     that shows the entry pointed at or chosen; the caption below,
     outside the frame -->
<div class="sheet area cv-section tl-head" style="--h: 1">
  <h2 id="timeline-title">Career timeline</h2>
  <p class="tl-key" aria-hidden="true"><span class="tl-key__bar tl-key__bar--major"></span>Roles<span class="tl-key__bar tl-key__bar--minor"></span>Freelance projects</p>
</div>
<figure class="sheet area tl-figure" id="timeline" aria-labelledby="timeline-title" data-snap>
  <div class="frame tl-frame" data-snap>
  <div class="tl-scroll" tabindex="0" role="region" aria-label="Timeline of roles and projects">
    <div class="tl" style="--years: {{ tl.years | length }}">
      {#- Heavier bars are roles; a freelance lane is one thin bar with a tick per project. cv.js draws them in, oldest first -#}
      {%- for year in tl.years %}
      <span class="tl__year" style="grid-column: {{ loop.index + 1 }}">{{ year }}</span>
      {%- endfor %}
      {% for lane in tl.lanes %}
      <p class="tl__name" data-lane="{{ lane.key }}" style="--y: {{ lane.y }}; --rows: {{ lane.rows }}; --yp: {{ lane.yp }}">{{ lane.name }}</p>
      <ol class="tl__track" data-lane="{{ lane.key }}" style="--y: {{ lane.y }}; --rows: {{ lane.rows }}; --yp: {{ lane.yp }}; --rp: {{ lane.rp }}">
        {%- for item in lane.items %}
        <li class="{{ 'is-major' if item.major else 'is-minor' }}{% if item.group %} is-group{% endif %}{% if item.ongoing %} is-ongoing{% endif %}{% if item.late %} is-late{% endif %}" data-id="{{ item.id }}" style="--s: {{ item.s }}; --e: {{ item.e }}; --r: {{ item.row }}"><a href="#{{ item.open or item.id }}">{{ item.label }}</a><span class="visually-hidden">, {{ item.title + ", " if item.group }}{{ item.spoken }}</span>
          {%- if item.group %}{% for m in item.members %}<span class="tl__tick" data-id="{{ m.id }}" aria-hidden="true" style="--ts: {{ m.s }}; --te: {{ m.e }}"></span>{% endfor %}{% endif -%}
        </li>
        {%- endfor %}
      </ol>
      {%- endfor %}

      <div class="tl__today" style="--s: {{ tl.today }}" aria-hidden="true"><span>Today</span></div>
    </div>
  </div>
  </div>
  <div class="tl-panel" id="tl-panel" role="region" aria-label="Selected entry" aria-live="polite" data-current="{{ tl.current }}">
    <div class="tl-panel__body"></div>
    <p class="tl-panel__hint" aria-hidden="true"></p>
  </div>
  <div hidden>
    {%- for lane in tl.lanes %}{% for item in lane.items %}
    {{ pv(item) }}
    {%- if item.group %}{% for m in item.members %}{{ pv(m) }}{% endfor %}{% endif %}
    {%- endfor %}{% endfor %}
  </div>
  <figcaption class="tl-caption"><span class="label">Fig. 1</span>Roles (heavy) and freelance work (light) since {{ timelineFrom }}. Point at or tap a bar to preview it, or a lane name to focus on it. The full entry is below.</figcaption>
</figure>

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

<!-- ============ Experience, most recent first ============ -->
<div class="sheet area cv-section" style="--h: 1">
  <h2 id="experience">Experience</h2>
  {#- cv.js opens or closes every row; hidden without JS (rows are then plain <details>) -#}
  <button class="btn cv-section__all" type="button" data-expand-all aria-pressed="false">Expand all</button>
</div>
{% for e in collections.cv | cvCards("experience") %}
{{ cv.card(e, collections.cv) }}
{% endfor %}

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

<!-- ============ Education ============ -->
<div class="sheet area cv-section" style="--h: 1">
  <h2 id="education">Education</h2>
</div>
{% for e in collections.cv | cvCards("education") %}
{{ cv.card(e, collections.cv) }}
{% endfor %}
