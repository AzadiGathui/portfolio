---
layout: layouts/page.njk
title: Portfolio
description: Azadi Gathui — Product Designer & Analyst. Portfolio of UX, editorial, and data visualisation work.
permalink: /
---
<main>
  <div class="hero-intro">
    <div style="text-align: center;">
      <h1>Azadi Gathui</h1>
      <p>Product Design & Analyst Portfolio 2026</p>
    </div>
    {# Decorative loops. No `autoplay` attribute: the script below starts them
       only when the visitor has not asked for reduced motion, and offers a
       pause control. Without JS, the poster frames show instead. #}
    <div class="hero-videos" aria-hidden="true">
      <video src="/assets/images/home/home hero loop 1.mp4" poster="/assets/images/home/home-hero-loop-1-poster.webp" loop muted playsinline preload="metadata"></video>
      <video src="/assets/images/home/home hero loop 3.mp4" poster="/assets/images/home/home-hero-loop-3-poster.webp" loop muted playsinline preload="metadata"></video>
      <video src="/assets/images/home/home hero loop 2.mp4" poster="/assets/images/home/home-hero-loop-2-poster.webp" loop muted playsinline preload="metadata"></video>
    </div>
    <button type="button" class="hero-motion-toggle" hidden>Pause animation</button>
    <img src="/assets/images/home/scroll.svg" alt="scroll for previous work">
  </div>

  <div style="display: flex; flex-direction: column; align-items: center; width: 100%;">
    <div>
      <p class="hero-section-label">Professional <br> Experience</p>
      <h2 class="projects-heading">Projects</h2>
    </div>

    <div class="projects-grid">
      {% for project in collections.projects %}
      <a href="{{ project.url }}" class="project-card">
        {% if project.data.thumbnail %}
          <img src="{{ project.data.thumbnail }}" alt="" sizes="(max-width: 768px) 100vw, 320px">
        {% endif %}
        <div class="project-card__body">
          {% if project.data.industry %}
            <span class="label label--muted">{{ project.data.industry }}</span>
          {% endif %}
          <h3>{{ project.data.title }}</h3>
          <p>{{ project.data.tagline }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</main>

<script>
/* Hero loop control — progressive enhancement.
   - Respects prefers-reduced-motion (no playback until the visitor opts in).
   - Provides a visible pause/play button (WCAG 2.2.2 Pause, Stop, Hide). */
(function () {
  var videos = document.querySelectorAll('.hero-videos video');
  var toggle = document.querySelector('.hero-motion-toggle');
  if (!videos.length || !toggle) return;

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The label follows what the videos are ACTUALLY doing, not what we asked for.
  // Browsers can refuse or stop playback on their own (autoplay policy, Safari
  // Low Power Mode, power saving), and the button must never offer to pause
  // something that isn't moving.
  function isPlaying() {
    return Array.prototype.some.call(videos, function (v) { return !v.paused; });
  }
  function updateLabel() {
    toggle.textContent = isPlaying() ? 'Pause animation' : 'Play animation';
  }
  function playAll() {
    videos.forEach(function (v) {
      var p = v.play();
      if (p && p.catch) p.catch(updateLabel); // refused: video stays paused, label says so
    });
  }
  function pauseAll() {
    videos.forEach(function (v) { v.pause(); });
  }

  videos.forEach(function (v) {
    v.addEventListener('play', updateLabel);
    v.addEventListener('pause', updateLabel);
  });
  toggle.hidden = false;
  toggle.addEventListener('click', function () { isPlaying() ? pauseAll() : playAll(); });
  updateLabel();
  if (!reduceMotion) playAll();
})();
</script>
