---
layout: layouts/base.njk
eleventyComputed:
  description: "Azadi Gathui, {{ site.role | lower | safe }}. Portfolio of UX, data science, editorial and data visualisation work."
permalink: /
hero: partials/home-hero.njk
scripts: [tip]
tools:
  - { img: correction-tape, edge: r, at: "--c: 14; --r: 31; --rot: -2deg" }
  - { img: earplugs, edge: l, at: "--c: 1; --r: 9; --rot: -2deg" }
  - { img: mechanical-pencil, edge: r, at: "--c: 14; --r: 7; --rot: 1deg" }
  - { img: icebear-cutter, edge: l, at: "--c: 1; --r: 20; --rot: 2deg" }
  - { img: kneadable-eraser, edge: r, at: "--c: 14; --r: 24; --rot: -2deg" }
  - { img: sharpener, edge: l, at: "--c: 1; --r: 34; --rot: -2deg" }
---
{#- The homepage. Its header (the line, the sentence, three photos) is on the desk
    above the mat: partials/home-hero.njk, set as `hero:` above. On the mat:
    Selected projects, More work, Previous clients and About, as in the Figma's "home". -#}

{#- A project's caption on a card: sector, then title; the arrow to its page in the last column.
    A project's own words for the card (cardLabel, cardTitle) win over its page's -#}
{% macro caption(project) -%}
  <span class="label">{{ project.data.cardLabel or project.data.industry }}</span>
  <div class="cap__body"><h3>{{ project.data.cardTitle or project.data.title }}</h3></div>
  <span class="go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2.5 8h10.5M9 4l4 4-4 4"/></svg></span>
{%- endmacro %}

<h2 class="sheet section-title" id="work" style="--x: 4; --w: 6; --h: 1">Selected projects</h2>

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

<!-- Selected projects: the first four in two staggered columns, read left, right, left, right.
     Each place is --x column and --w width, in cells, then the side the artefact overhangs (into the
     two empty columns between the pair; it shows only while the card is pointed at). Every card is
     the same size, so their rows are set in style.css: the right card starts two squares below the left
     one, and each next pair two squares below the card above it, the same two squares as the gap
     between the columns. The projects take the places in their order. -->
{%- set places = [[1, 5, "r"], [8, 5, "l"], [1, 5, "r"], [8, 5, "l"]] %}
<div class="sheet area work" data-snap>
  {%- for project in collections.projects.slice(0, places.length) %}
  {%- set at = places[loop.index0] %}
  <a class="card card--{{ at[2] }}{% if loop.first %} has-note{% endif %}" href="{{ project.url }}" style="--x: {{ at[0] }}; --w: {{ at[1] }}">
    <div class="frame frame--plain"><img src="{{ project.data.cardImage or project.data.coverImage }}" alt="" sizes="(max-width: 720px) 150vw, 640px"{% if project.data.cardPosition or project.data.coverPosition %} style="object-position: {{ project.data.cardPosition or project.data.coverPosition }}"{% endif %}>{% if loop.first %}<span class="note" aria-hidden="true">a recent favourite &darr;</span>{% endif %}</div>
    {%- if project.data.thumbnail %}
    {%- if project.data.thumbnailKind == 'phone' and project.data.mockupImage %}
    <span class="card__art card__art--phone"><span class="phone-frame"><img src="{{ project.data.mockupImage }}" alt="" sizes="(max-width: 720px) 45vw, 260px"></span></span>
    {%- else %}
    <span class="card__art card__art--{{ project.data.thumbnailKind or 'print' }}"><img src="{{ project.data.thumbnail }}" alt="" sizes="(max-width: 720px) 60vw, 420px"></span>
    {%- endif %}
    {%- endif %}
    <div class="card__cap cap">{{ caption(project) }}</div>
  </a>
  {%- endfor %}
</div>
<script>
  // No hover on a touch screen: a cover takes its colour while its
  // card is in the middle of the screen instead (.is-lit in style.css)
  if (matchMedia("(hover: none)").matches && "IntersectionObserver" in window) {
    const lit = new IntersectionObserver((seen) => seen.forEach((e) => e.target.classList.toggle("is-lit", e.isIntersecting)), { rootMargin: "-35% 0px -35% 0px" });
    document.currentScript.previousElementSibling.querySelectorAll(".card").forEach((card) => lit.observe(card));
  }
</script>

<div class="gap" aria-hidden="true"></div>

<h2 class="sheet section-title" style="--x: 4; --w: 6; --h: 1">More work</h2>

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

<!-- More work: the rest, as the mockups themselves lying on the mat. Pointing at one (or focusing it, or a
     first tap) opens a card beside it with what the project was, the way a team member's face opens
     their name (tip.js); the card is part of the link, so clicking it goes to the project. Places are
     --x column, --y row, in cells: three across, then two centred under them. On a phone, two across. -->
{%- set spots = [[1, 1], [5, 1], [9, 1], [3, 4], [7, 4]] %}
<nav class="sheet area wall" style="--h: 6" aria-label="More work" data-snap>
  {%- for project in collections.projects.slice(places.length) %}
  {%- set at = spots[loop.index0] or [1, 1] %}
  <a class="wall__item" data-tip="hover" href="{{ project.url }}" style="--x: {{ at[0] }}; --y: {{ at[1] }}; --w: 4; --h: 3">
    <img src="{{ project.data.thumbnail or project.data.coverImage }}" alt="{{ project.data.title }}" sizes="(max-width: 720px) 45vw, 280px">
    <span class="tip"><span class="tip__card wall__card">
      <span class="label">{{ project.data.industry }}</span>
      <h3>{{ project.data.title }}</h3>
      <span class="cap__what">{{ project.data.deliverables if project.data.deliverables is string else project.data.deliverables[0] }}{% if project.data.client %} &middot; {{ project.data.client }}{% endif %}</span>
      <span class="go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M2.5 8h10.5M9 4l4 4-4 4"/></svg></span>
    </span></span>
  </a>
  {%- endfor %}
</nav>

<div class="gap" aria-hidden="true"></div>

<h2 class="sheet section-title" style="--x: 4; --w: 6; --h: 1">Previous clients</h2>

<div class="gap" style="--rows: 1" aria-hidden="true"></div>

{#- Their marks (the Figma's own vectors, white), each at the height it has there -#}
<div class="sheet clients" style="--h: 4" data-snap>
  {%- for logo in [
    { file: "ayicc.svg", name: "African Youth Initiative on Climate Change", h: 56 },
    { file: "ciff.svg", name: "Children’s Investment Fund Foundation", h: 40 },
    { file: "greenpeace.svg", name: "Greenpeace", h: 32 },
    { file: "unfccc-champions.svg", name: "UN Climate Change High-Level Champions", h: 48 },
    { file: "inable.png", name: "inABLE", h: 40 },
    { file: "leja.svg", name: "Leja", h: 32 },
    { file: "kwetupride.svg", name: "Kwetu Pride", h: 32 },
    { file: "jireh.svg", name: "Jireh Health", h: 32 },
    { file: "lcoy.svg", name: "LCOY Kenya", h: 48 },
    { file: "sid.svg", name: "Society for International Development", h: 84 }
  ] %}
  <img src="/assets/images/home/clients/{{ logo.file }}" alt="{{ logo.name }}" style="--logo-h: {{ logo.h }}px" loading="lazy">
  {%- endfor %}
</div>

<div class="gap" aria-hidden="true"></div>

<!-- About: the portrait as a print, the words beside it -->
<figure class="sheet frame frame--polaroid about__print" id="about" style="--x: 2; --w: 3; --h: 4"><img src="/assets/images/home/about-print.jpg" alt="Azadi Gathui smiling, in a coral jacket, with long braids, in front of green leaves" sizes="(max-width: 720px) 60vw, 216px" loading="lazy"><figcaption>{{ site.role }}</figcaption></figure>
<section class="sheet about__bio" style="--x: 6; --w: 6; --h: 4" data-snap>
  <p class="label">Hi, I’m {{ site.author }}.</p>
  <h2>7+ years of turning gnarly problems into human-centred solutions.</h2>
  <p>I come to every collaboration with genuine curiosity, informed experimentation, and the kind of thinking that connects dots across fields. If it challenges assumptions, connects disciplines, or helps real humans live better, I'm probably already thinking about it.</p>
</section>
