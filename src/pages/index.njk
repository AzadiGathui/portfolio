---
layout: layouts/page.njk
title: Portfolio
description: Azadi Gathui — Product Designer & Analyst. Portfolio of UX, editorial, and data visualisation work.
permalink: /
---
<main>
  <div class="hero-intro">
    <div style="text-align: center;">
      <h1>Azadi Gathui</h1>
      <p>Product Design & Analyst Portfolio 2026</p>
    </div>
    <div class="hero-videos">
      <video src="/assets/images/home/home hero loop 1.mp4" autoplay loop muted playsinline></video>
      <video src="/assets/images/home/home hero loop 3.mp4" autoplay loop muted playsinline></video>
      <video src="/assets/images/home/home hero loop 2.mp4" autoplay loop muted playsinline></video>
    </div>
    <img src="/assets/images/home/scroll.svg" alt="scroll for previous work">
  </div>

  <div style="display: flex; flex-direction: column; align-items: center; width: 100%;">
    <div>
      <p class="hero-section-label">Professional <br> Experience</p>
      <h2 class="projects-heading">Projects</h2>
    </div>

    {% for project in collections.projects %}
    <div class="project-card">
      {% if project.data.thumbnail %}
        <img src="{{ project.data.thumbnail }}" alt="{{ project.data.title }} thumbnail">
      {% endif %}
      <div>
        <h3 style="margin-top:0;">
          <a href="{{ project.url }}" style="text-decoration: none;">
            {{ project.data.title }}
          </a>
        </h3>
        <p style="color: #e6e6e690;">{{ project.data.tagline }}</p>
      </div>
    </div>
    {% endfor %}
  </div>
</main>
