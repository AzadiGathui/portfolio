---
layout: layouts/page.njk
title: Resources
description: Articles, prototypes and live tools by Azadi Gathui for design engineers and data scientists.
permalink: /resources/
---
<main>
  <div class="hero-intro" style="padding-top: 8rem;">
    <div style="text-align: center;">
      <span class="label label--muted">Personal · Practice</span>
      <h1>Resources</h1>
      <p style="opacity: 0.55; max-width: 36ch; margin: 1rem auto 0;">Articles, prototypes and live tools for design engineers and data scientists.</p>
    </div>
  </div>

  <div style="display: flex; flex-direction: column; align-items: center; width: 100%;">
    <div class="projects-grid">
      {% for resource in collections.resources %}
      <a href="{{ resource.url }}" class="project-card">
        {% if resource.data.thumbnail %}
          <img src="{{ resource.data.thumbnail }}" alt="{{ resource.data.title }} thumbnail">
        {% endif %}
        <div class="project-card__body">
          {% if resource.data.type %}
            <span class="label label--muted">{{ resource.data.type }}</span>
          {% endif %}
          <h3>{{ resource.data.title }}</h3>
          <p>{{ resource.data.tagline }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</main>
