---
# A project's case study on the craft mat, for each project with
# `craftPage: true` (collection "craftProjects"): the same markdown as its
# main page, laid out on the mat. The homepage links here when it exists.
pagination:
  data: collections.craftProjects
  size: 1
  alias: project
permalink: "/craft/projects/{{ project.fileSlug }}/"
eleventyExcludeFromCollections: true
eleventyImport:
  collections: ["craftProjects"]
---
{%- set d = project.data %}
{%- set toc = project.content | tocEntries %}
{%- set at = collections.projects | getProjectIndex(project.url) %}
{#- Previous and next wrap round the list, so the pager always has both -#}
{%- set next = collections.projects[at + 1] or collections.projects[0] %}
{%- set prev = collections.projects[at - 1] if at > 0 else collections.projects[collections.projects.length - 1] %}
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ d.title }} | Azadi Gathui</title>
  <meta name="description" content="{{ d.description }}">
  <meta name="robots" content="noindex">
  <meta name="color-scheme" content="dark">
  <link rel="icon" href="/assets/images/branding/favicon.png">
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400&display=swap"> {#- margin notes; self-host once settled -#}
  <link rel="stylesheet" href="/assets/css/craft.css">
  <script src="/assets/js/craft-snap.js" defer></script>
  <script src="/assets/js/craft-tools.js" defer></script>
  <script src="/assets/js/craft-reels.js" defer></script>
  <script src="/assets/js/craft-reading.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <div class="desk">
    <div class="mat">

      {% set keysActive = "home" %}{% include "partials/craft-keys.njk" %}

      <main class="mat__content" id="main">

        <header class="sheet" style="--w: 10; --h: 4" data-snap>
          <span class="label">{{ d.industry }}</span>
          <h1>{{ d.title }}</h1>
          <p>{{ d.description }}</p>
        </header>

        <!-- The cover, with the artefact laid on it, as on the homepage card -->
        <figure class="sheet cover card--r" style="--h: 6">
          <div class="frame frame--plain"><img src="{{ d.coverImage }}" alt="" sizes="(max-width: 720px) 90vw, 880px" loading="eager"{% if d.coverPosition %} style="object-position: {{ d.coverPosition }}"{% endif %}></div>
          {%- if d.thumbnail %}
          {%- if d.thumbnailKind == 'phone' and d.mockupImage %}
          <span class="card__art card__art--phone"><span class="phone-frame"><img src="{{ d.mockupImage }}" alt="" sizes="(max-width: 720px) 30vw, 160px" loading="eager"></span></span>
          {%- else %}
          <span class="card__art card__art--{{ d.thumbnailKind or 'print' }}"><img src="{{ d.thumbnail }}" alt="" sizes="220px" loading="eager"></span>
          {%- endif %}
          {%- endif %}
        </figure>

        <dl class="sheet facts" style="--h: 2" data-snap>
          <div><dt class="label">Client</dt><dd>{{ d.client }}</dd></div>
          {%- if d.role %}<div><dt class="label">Role</dt><dd>{{ d.role }}</dd></div>{% endif %}
          {%- if d.timeline %}<div><dt class="label">Timeline</dt><dd>{{ d.timeline }}</dd></div>{% endif %}
          {%- if d.platform %}<div><dt class="label">Platform</dt><dd>{{ d.platform }}</dd></div>{% endif %}
        </dl>

        <div class="gap" aria-hidden="true"></div>

        <!-- Case study: contents on the left stick while the body scrolls -->
        <div class="sheet area study" data-snap>
          {%- if toc.length %}
          <nav class="toc" aria-label="On this page">
            <ol>
              {%- for item in toc %}
              <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
              {%- endfor %}
            </ol>
          </nav>
          {%- endif %}
          <div class="area study__body">
            <div class="sheet prose" data-snap>{{ project.content | craftReels | safe }}</div>
          </div>
        </div>

        <div class="gap" aria-hidden="true"></div>

        <!-- Previous / next: the live site's project pager, as two black frames on the grid -->
        <nav class="sheet area pager" aria-label="Project navigation">
          {%- for dir, p in [["prev", prev], ["next", next]] %}
          <a class="frame pager__item pager__item--{{ dir }}" href="{{ ('/craft/projects/' + p.fileSlug + '/') if p.data.craftPage else p.url }}">
            <span class="pager__thumb"><img src="{{ p.data.thumbnail or p.data.coverImage }}" alt="" sizes="(max-width: 720px) 30vw, 280px" loading="lazy"></span>
            <span class="label pager__label">{% if dir == "prev" %}&larr; Previous{% else %}Next &rarr;{% endif %}</span>
            <h3 class="pager__title">{{ p.data.title }}</h3>
          </a>
          {%- endfor %}
        </nav>

        <div class="gap" aria-hidden="true"></div>

        {% include "partials/craft-footer.njk" %}
      </main>

      <div class="mat__tools" aria-hidden="true">
        <div class="tool tool--r" style="--c: 14; --r: 4; --w: 1; --h: 2; --rot: 4deg; --tint: #8fbcd4; --cs: 6; --rs: 4; --ws: 1; --hs: 2">tape</div>
        <div class="tool tool--l" style="--c: 1; --r: 9; --w: 1; --h: 9; --rot: -1deg; --tint: #c9a227">ruler</div>
        <div class="tool tool--r" style="--c: 14; --r: 22; --w: 1; --h: 3; --rot: 2deg; --tint: #f07a2a">craft knife</div>
        <div class="tool tool--l" style="--c: 1; --r: 34; --w: 1; --h: 1; --rot: -6deg; --tint: #b8c4cc">paper clips</div>
      </div>

    </div>
  </div>
  {#- Phones: the section you are in, which opens the contents, and an up
      arrow while scrolling back up (craft-reading.js; the live site's
      reading bar) -#}
  <div class="reading-bar">
    {%- if toc.length %}
    <button type="button" class="toc-pill" aria-haspopup="dialog" aria-controls="toc-sheet">
      <span class="vh">Contents: </span><span class="toc-pill__count label"></span><span class="toc-pill__section">Contents</span>
    </button>
    {%- endif %}
    <a href="#" class="to-top" aria-label="Back to top"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg></a>
  </div>
  {%- if toc.length %}
  <dialog class="toc-sheet" id="toc-sheet" aria-labelledby="toc-sheet-title">
    <div class="toc-sheet__head">
      <span class="label" id="toc-sheet-title">Contents</span>
      <button type="button" class="toc-sheet__close" aria-label="Close contents">&#x2715;</button>
    </div>
    <ol>
      {%- for item in toc %}
      <li><a href="#{{ item.id }}">{{ item.text }}</a></li>
      {%- endfor %}
    </ol>
  </dialog>
  {%- endif %}
</body>
</html>
